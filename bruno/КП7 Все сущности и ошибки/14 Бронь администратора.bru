meta {
  name: Бронь администратора
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/bookings
  body: json
  auth: inherit
}

body:json {
  {
    "table_id": 13,
    "starts_at": "{{in20days}} 13:00:00",
    "ends_at": "{{in20days}} 15:00:00",
    "guests_count": 2
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("bookingId", res.body.data.id);
  }
}

docs {
  Бронь для проверки предзаказа (многие ко многим).
}
