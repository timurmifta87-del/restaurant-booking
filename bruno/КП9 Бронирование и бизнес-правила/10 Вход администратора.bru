meta {
  name: Вход администратора
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@resto.test",
    "password": "password"
  }
}

script:post-response {
  if (res.body.token) {
    bru.setVar("token", res.body.token);
  }
}

docs {
  Вход под admin@resto.test. Токен сохраняется в переменную token.

  Ответ 200: `{ user, token }`. Ошибка: 401 «Неверный email или пароль», 422.
}
